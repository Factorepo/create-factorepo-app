# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# The database URL is used to connect to your self-hosted PostgreSQL database.
# Format: postgres://username:password@host:port/database
POSTGRES_URL="postgresql://postgres:password@localhost:5432/acme"

# The public URL of the deployed app (scheme included, no trailing slash).
# Required in production; auth callbacks and server-side fetches derive from it.
# Falls back to http://localhost:3000 in development.
APP_URL=''


# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Preconfigured Discord OAuth provider, works out-of-the-box
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# --- @acme/storage ---
# S3-compatible object store. Credentials ride in the URL; `bucket` and `region`
# are read from the query string.
STORAGE_URL='https://access_key:secret_key@garage.example.com:443?bucket=acme&region=garage'
# Only used to sign URLs the browser opens, so its host must be browser
# reachable and CORS-configured. Falls back to STORAGE_URL when unset.
STORAGE_PUBLIC_URL=''

# --- @acme/gemini ---
# Both optional. Vertex AI falls back to the project on the ambient Google
# credentials, and the location defaults to 'global'.
GOOGLE_CLOUD_PROJECT=''
GOOGLE_CLOUD_LOCATION='global'
GOOGLE_APPLICATION_CREDENTIALS=''

# --- @acme/payment ---
# PADDLE_ENVIRONMENT selects the sandbox unless it reads 'production'.
PADDLE_API_KEY=''
PADDLE_WEBHOOK_SECRET=''
PADDLE_STANDARD_PRICE_ID=''
PADDLE_ENVIRONMENT='sandbox'

# --- @acme/email ---
CLOUDFLARE_API_TOKEN=''
CLOUDFLARE_ACCOUNT_ID=''

# --- @acme/service ---
# 'debug' | 'info' | 'warn' | 'error'. Defaults to 'info' in production and
# 'debug' everywhere else.
LOG_LEVEL='debug'
